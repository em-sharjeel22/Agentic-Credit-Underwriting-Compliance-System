.lang-toggle label { cursor: pointer; position: relative; background-color:=
 var(--sbp-green); border-radius: 20px; display: flex; align-items: center;=
 padding: 4px 9px; font-size: 13px; color: var(--ColorWhite); min-width: 55=
px; user-select: none; justify-content: space-between; font-family: var(--f=
ontManrope) !important; }

.lang-toggle label span { transition: 0.2s ease-in-out; }

.lang-toggle label::after { position: absolute; top: 50%; transform: transl=
ate(-50%, -50%); right: -14%; height: 80%; aspect-ratio: 1 / 1; border-radi=
us: 50%; content: ""; background-color: var(--ColorWhite); transition: 0.2s=
 ease-in-out; }

.lang-toggle label:hover::after { transform: translate(-50%, -50%) scale(0.=
95) !important; }

