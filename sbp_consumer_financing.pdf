: 1.25rem; --font-18: 1.125rem; --font-16: 1rem; --font-15: 0.938rem; --fon=
t-14: .875rem; --font-12: .75rem; --font-11: .688rem; --line-height-78: 5re=
m; --line-height-30: 2rem; --fontManrope: "Manrope", sans-serif; --balck-te=
xt: #231F20; --gray-text: #4A4A4A; --black: #000000; --black-10: #00000040;=
 --gray-10: #C7C7C7; --gray-20: #FAFAFA; --ColorWhite: #fff; --scrollbar-gr=
ey: #DDDDDD; --light-grey: #F4F4F4; --sbp-green: #007236; --light-green-bor=
der: #4BAE3273; --light-green: #F6FFEF; --header-height: 0px; --nav-height:=
 120px; --brand-gradient: linear-gradient(92.04deg, #F6B323 -41.22%, #F6B32=
3 -5.19%, #C1E4A5 43.03%, #1DC3C5 72.28%); --green-gradient: linear-gradien=
t(180deg, rgba(75, 174, 50, 0.6) 0%, #007236 100%); --slider-height: calc(1=
00vh - var(--header-height) - 50px); --sbp-green-filter: brightness(0) satu=
rate(100%) invert(26%) sepia(11%) saturate(7500%) hue-rotate(120deg) bright=
ness(109%) contrast(101%); --hover-box-shadow: rgba(9, 170, 62, 0.24) 0px 4=
px 12px; --hover-box-shadow-normal: rgba(0, 0, 0, 0.24) 0px 4px 12px; }

