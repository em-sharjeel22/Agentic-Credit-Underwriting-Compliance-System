@charset "utf-8";

@import url("https://fonts.googleapis.com/css2?family=3DManrope:wght@200..8=
00&display=3Dswap");

*, ::before, ::after { box-sizing: border-box; }

* { margin: 0px; padding: 0px; font-variant-ligatures: none; }

html { font-size: 1rem; text-size-adjust: 100%; scroll-behavior: smooth; }

body { line-height: 1.5; font-family: -apple-system, BlinkMacSystemFont, "S=
egoe UI", Roboto, Oxygen, Ubuntu, Cantarell, "Open Sans", "Helvetica Neue",=
 sans-serif; background: rgb(255, 255, 255); color: rgb(0, 0, 0); text-rend=
ering: optimizelegibility; -webkit-font-smoothing: antialiased; }

body.no-scroll { overflow: hidden; padding-right: 15px; }

body { font-family: var(--fontManrope); padding-top: var(--header-height); =
}

h1, h2, h3, h4, h5, h6 { font-size: inherit; font-weight: inherit; }

ul { list-style: none; }

ol li:not(:last-child) { margin-bottom: 0.8rem; }

ol ol { margin-top: 0.8rem; }

ol ul { margin-top: 0.8rem; list-style-type: circle; }

a { text-decoration: none; color: inherit; }

a { color: var(--sbp-green); transition: 0.2s ease-in-out; }

a:hover { color: var(--balck-text); }

img, picture, video, canvas, svg { max-width: 100%; height: auto; }

button, input, select, textarea { font: inherit; color: inherit; background=
: transparent; border-width: medium; border-style: none; border-color: curr=
entcolor; border-image: none; outline: none; }

button { cursor: pointer; }

textarea { resize: vertical; }

table { border-collapse: collapse; border-spacing: 0px; width: 100%; }

blockquote, q { quotes: none; }

blockquote::before, blockquote::after, q::before, q::after { content: none;=
 }

hr { border-width: 1px medium medium; border-style: solid none none; border=
-color: currentcolor; border-image: none; opacity: 0.2; }

[hidden] { display: none !important; }

b, strong { font-weight: bolder; }

i, em { font-style: italic; }

p { color: var(--gray-text); font-size: var(--font-22); }

p.align-center { text-align: center; }

@media (max-width: 1699px) {
  p { font-size: var(--font-18); }
}

:root { --mainHeading: 3.28125rem; --subHeading: 1.25rem; --font-78: 4.375r=
em; --font-52: 3.25rem; --font-46: 2.875rem; --font-40: 2.5rem; --font-38: =
